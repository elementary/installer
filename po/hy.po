#, c-format
msgid "%s has been installed"
msgstr "%s-ը տեղադրվել է"

#: src/Views/SuccessView.vala:58
msgid "Shut Down"
msgstr "Անջատել"

#: src/Views/SuccessView.vala:89
#, c-format
msgid "Your device will automatically restart in %i second."
msgid_plural "Your device will automatically restart in %i seconds."
msgstr[0] "Ձեր սարքն ավտոմատ կվերագործարկվի %i վայրկյանից։"
msgstr[1] "Ձեր սարքն ավտոմատ կվերագործարկվի %i վայրկյանից։"

#: src/Views/SuccessView.vala:93
msgid ""
"After restarting you can set up a new user, or you can shut down now and set "
"up a new user later."
msgstr ""
"Վերագործարկումից հետո կարող եք ստեղծել նոր օգտատեր կամ անջատել սարքը հիմա և "
"ստեղծել նոր օգտատեր ավելի ուշ։"

