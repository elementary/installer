#: src/Application.vala:54
msgid "Connect to a Power Source"
msgstr "Bi çavkaniyeke ceryanê ve girê bide"

#: src/Application.vala:55
msgid "Installation will not succeed if this device loses power."
msgstr "Ku ev amûr ceryanê winda bike, wê sazkirin têk biçe."

#: src/Application.vala:68
#, c-format
msgid "Install %s"
msgstr "%s saz bike"

#: src/Application.vala:76
msgid "operating system is being installed"
msgstr "pergala xebatê tê sazkirin"

#: src/Utils.vala:34
msgid "Test mode shutdown"
msgstr "Girtina moda ceribandinê"

#: src/Utils.vala:48
msgid "Test mode reboot"
msgstr "Ji nû ve destpêkirina moda testkirinê"

#: src/Utils.vala:74
msgid "Test mode switch user"
msgstr "Guhertina bikarhêner a awaya testkirinê"

